# Скопируй в .env и подставь свои значения. Файл .env в git не попадает.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=change-me

AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth
AUTH_REDIS_URL=redis://:change-me@localhost:6379/0
# RSA-ключ для подписи JWT: вывод команды `openssl genrsa 2048` целиком, в кавычках
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
PROJECTS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/projects
RUNS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/runs
