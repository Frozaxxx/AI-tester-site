POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_USER=ai_tester
RABBITMQ_PASSWORD=change-me
REDIS_PASSWORD=change-me

AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth
AUTH_REDIS_URL=redis://:change-me@localhost:6379/0
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
PROJECTS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/projects
RUNS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/runs

GATEWAY_REDIS_URL=redis://:change-me@localhost:6379/0

JWT_ALGORITHM=RS256
JWT_ISSUER=ai-tester-auth
JWT_AUDIENCE=ai-tester-api

AUTH_GRPC_HOST=127.0.0.1
AUTH_GRPC_PORT=50051
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_DAYS=1
AUTH_LOGIN_ATTEMPTS_LIMIT=5
AUTH_LOGIN_BLOCK_MINUTES=15
PROJECTS_GRPC_HOST=127.0.0.1
PROJECTS_GRPC_PORT=50052
PROJECTS_ALLOW_INTERNAL_URLS=false
RUNS_GRPC_HOST=127.0.0.1
RUNS_GRPC_PORT=50053
RUNS_RABBITMQ_URL=amqp://ai_tester:change-me@localhost:5672/

GATEWAY_AUTH_GRPC_ADDRESS=127.0.0.1:50051
GATEWAY_PROJECTS_GRPC_ADDRESS=127.0.0.1:50052
GATEWAY_RUNS_GRPC_ADDRESS=127.0.0.1:50053
GATEWAY_COOKIE_SECURE=true
RUNNER_RUNS_GRPC_ADDRESS=127.0.0.1:50053
RUNNER_PROJECTS_GRPC_ADDRESS=127.0.0.1:50052
RUNNER_RABBITMQ_URL=amqp://ai_tester:change-me@localhost:5672/
RUNNER_ALLOW_INTERNAL_URLS=false
RUNNER_POLL_INTERVAL_SECONDS=30
RUNNER_GIGACHAT_CREDENTIALS=change-me
RUNNER_GIGACHAT_SCOPE=GIGACHAT_API_PERS
RUNNER_LLM_PROVIDER=none
RUNNER_GIGACHAT_CA_BUNDLE_FILE=
